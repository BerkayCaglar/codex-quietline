{
  "name": "codex-quietline",
  "version": "0.1.0",
  "description": "A quiet, agent-aware terminal for Codex. Your conversation, subagents, and context in view.",
  "type": "module",
  "bin": {
    "codex-quietline": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Berkay Caglar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BerkayCaglar/codex-quietline.git"
  },
  "bugs": "https://github.com/BerkayCaglar/codex-quietline/issues",
  "homepage": "https://github.com/BerkayCaglar/codex-quietline#readme",
  "keywords": [
    "codex",
    "terminal",
    "tui",
    "subagents",
    "statusline",
    "quietline"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "prepack": "npm run build",
    "media": "tsx scripts/media.tsx"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cross-spawn": "7.0.6",
    "ink": "7.1.1",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
